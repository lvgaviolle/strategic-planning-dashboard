@page "/"
@inject PlanningStore Store

<PageTitle>Visão geral | Northstar</PageTitle>

<div class="heading-row">
    <div>
        <div class="eyebrow">PAINEL EXECUTIVO</div>
        <h1>Visão geral</h1>
        <p class="page-description">Uma visão clara do desempenho das metas neste período.</p>
    </div>
    <a class="button button-primary" href="/metas"><span aria-hidden="true">＋</span> Gerenciar metas</a>
</div>

<section class="hero-card" aria-label="Resumo do período">
    <div>
        <div class="hero-overline">ACOMPANHAMENTO MENSAL</div>
        <h2>@PeriodLabel</h2>
        <p>Dados de demonstração para explorar indicadores, resultados e prioridades.</p>
        <div class="hero-tags"><span>● 4 áreas de negócio</span><span>● 3 unidades</span></div>
    </div>
    <div class="hero-score">
        <span class="hero-score-label">ATINGIMENTO MÉDIO</span>
        <strong>@AverageProgress.ToString("N1", BrazilianCulture)%</strong>
        <span>das metas filtradas</span>
    </div>
</section>

<div class="filter-surface">
    <div class="filter-title"><span>☷</span> Filtros <small>Refine os resultados exibidos</small></div>
    <div class="filter-grid">
        <label class="field-label">
            Período
            <select class="field-input" @bind="SelectedPeriodKey">
                @foreach (var period in AvailablePeriods)
                {
                    <option value="@PeriodKey(period)">@period.ToString("MMMM/yyyy", BrazilianCulture)</option>
                }
            </select>
        </label>
        <label class="field-label">
            Unidade
            <select class="field-input" @bind="SelectedBranch">
                <option value="Todas">Todas as unidades</option>
                @foreach (var branch in PlanningStore.Branches)
                {
                    <option value="@branch">@branch</option>
                }
            </select>
        </label>
        <label class="field-label">
            Área
            <select class="field-input" @bind="SelectedArea">
                <option value="Todas">Todas as áreas</option>
                @foreach (var area in PlanningStore.Areas)
                {
                    <option value="@area">@area</option>
                }
            </select>
        </label>
        <label class="field-label field-search">
            Buscar meta
            <input class="field-input" type="search" placeholder="Nome ou responsável..." @bind="SearchTerm" @bind:event="oninput" />
        </label>
    </div>
</div>

<section class="content-card trends-card" aria-label="Histórico mensal">
    <div class="content-card-header">
        <div>
            <h2>Evolução das metas</h2>
            <p>Atingimento médio normalizado, com cada indicador limitado a 100% no consolidado.</p>
        </div>
        <span class="count-pill">Últimos 6 meses</span>
    </div>
    <div class="trend-bars">
        @foreach (var item in TrendData)
        {
            <div class="trend-row">
                <span class="trend-month">@item.Period.ToString("MMM/yy", BrazilianCulture)</span>
                <div class="trend-track">
                    <div class="trend-fill" style="width: @(item.AverageProgress.ToString(CultureInfo.InvariantCulture))%"></div>
                </div>
                <strong>@item.AverageProgress.ToString("N1", BrazilianCulture)%</strong>
            </div>
        }
    </div>
</section>

<div class="metric-grid" aria-label="Resumo das metas">
    <div class="metric-card">
        <div class="metric-top"><span>Metas acompanhadas</span><span class="metric-icon neutral">▤</span></div>
        <div class="metric-value">@VisibleGoals.Count</div>
        <div class="metric-caption">Indicadores ativos no filtro</div>
    </div>
    <div class="metric-card">
        <div class="metric-top"><span>Metas atingidas</span><span class="metric-icon success">✓</span></div>
        <div class="metric-value">@Achieved</div>
        <div class="metric-caption"><span class="accent-good">@ShareOf(Achieved)%</span> do total filtrado</div>
    </div>
    <div class="metric-card">
        <div class="metric-top"><span>Em atenção</span><span class="metric-icon warning">◷</span></div>
        <div class="metric-value">@Attention</div>
        <div class="metric-caption">Entre 80% e 99,9% da meta</div>
    </div>
    <div class="metric-card">
        <div class="metric-top"><span>Abaixo da meta</span><span class="metric-icon danger">↘</span></div>
        <div class="metric-value">@Below</div>
        <div class="metric-caption">Atingimento inferior a 80%</div>
    </div>
</div>

<section class="content-card">
    <div class="content-card-header">
        <div>
            <h2>Desempenho por indicador</h2>
            <p>Acompanhe o previsto e o realizado de cada meta.</p>
        </div>
        <span class="count-pill">@VisibleGoals.Count resultados</span>
    </div>
    @if (VisibleGoals.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">⌕</div>
            <h3>Nenhuma meta encontrada</h3>
            <p>Experimente alterar os filtros ou cadastrar uma nova meta.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>INDICADOR</th>
                        <th>UNIDADE</th>
                        <th class="numeric">PREVISTO</th>
                        <th class="numeric">REALIZADO</th>
                        <th>ATINGIMENTO</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var goal in VisibleGoals)
                    {
                        <tr @key="goal.Id">
                            <td>
                                <div class="cell-title">@goal.Title</div>
                                <div class="cell-subtitle">@goal.Area · @goal.Owner</div>
                            </td>
                            <td><span class="branch-name">@goal.Branch</span></td>
                            <td class="numeric strong-number">@goal.Format(goal.Target)</td>
                            <td class="numeric strong-number">@goal.Format(goal.Actual)</td>
                            <td>
                                <div class="progress-line"><div class="progress-fill @goal.StatusClass" style="width: @(Math.Clamp(goal.Progress, 0m, 100m).ToString(CultureInfo.InvariantCulture))%"></div></div>
                                <span class="progress-number">@goal.Progress.ToString("N1", BrazilianCulture)%</span>
                            </td>
                            <td><span class="status-pill @goal.StatusClass"><span class="status-dot"></span>@goal.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="info-note"><span aria-hidden="true">ⓘ</span> Esta aplicação usa dados fictícios. As alterações são salvas em SQLite local e compartilhadas entre as sessões deste servidor. Não publique sem autenticação.</div>

@code {
    private static readonly CultureInfo BrazilianCulture = CultureInfo.GetCultureInfo("pt-BR");
    private string SelectedBranch = "Todas";
    private string SelectedArea = "Todas";
    private string SearchTerm = "";
    private string SelectedPeriodKey = PeriodKey(DateTime.Today);
    private static string PeriodKey(DateTime period) => period.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private DateTime SelectedPeriod =>
        DateTime.TryParseExact(SelectedPeriodKey + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var value)
            ? value : new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<DateTime> AvailablePeriods => Enumerable.Range(0, 6)
        .Select(i => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-i))
        .ToList();

    private List<PeriodSummary> TrendData => AvailablePeriods.AsEnumerable().Reverse()
        .Select(period => GoalMetrics.Summarize(FilteredAllPeriods, period))
        .ToList();

    private IEnumerable<Goal> FilteredAllPeriods => Store.Goals
        .Where(g => SelectedBranch == "Todas" || g.Branch == SelectedBranch)
        .Where(g => SelectedArea == "Todas" || g.Area == SelectedArea)
        .Where(g => string.IsNullOrWhiteSpace(SearchTerm)
            || g.Title.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
            || g.Owner.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));

    private string PeriodLabel => SelectedPeriod.ToString("MMMM 'de' yyyy", BrazilianCulture);
    private List<Goal> VisibleGoals => FilteredAllPeriods
        .Where(g => g.IsActive && g.Month == SelectedPeriod.Month && g.Year == SelectedPeriod.Year)
        .OrderBy(g => g.Progress)
        .ToList();

        private int Achieved => VisibleGoals.Count(g => g.Progress >= 100);
    private int Attention => VisibleGoals.Count(g => g.Progress >= 80 && g.Progress < 100);
    private int Below => VisibleGoals.Count(g => g.Progress < 80);
    private decimal AverageProgress => GoalMetrics.Summarize(VisibleGoals, SelectedPeriod).AverageProgress;
    private decimal ShareOf(int number) => VisibleGoals.Count == 0 ? 0 : Math.Round(number * 100m / VisibleGoals.Count, 1);
}
