@page "/metas"
@inject PlanningStore Store

<PageTitle>Gestão de metas | Northstar</PageTitle>

<div class="heading-row">
    <div>
        <div class="eyebrow">ADMINISTRAÇÃO</div>
        <h1>Gestão de metas</h1>
        <p class="page-description">Cadastre, atualize e acompanhe indicadores fictícios.</p>
    </div>
    <button class="button button-primary" type="button" @onclick="ToggleForm"><span aria-hidden="true">＋</span> @(ShowForm ? "Fechar formulário" : "Nova meta")</button>
</div>

@if (ShowForm)
{
    <section class="content-card create-panel">
        <div class="content-card-header"><div><h2>Nova meta mensal</h2><p>O novo registro será criado para @PeriodLabel.</p></div></div>
        <EditForm Model="Draft" OnValidSubmit="CreateGoal" FormName="createGoal">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />
            <div class="create-grid">
                <label class="field-label wide">
                    Nome do indicador
                    <InputText class="field-input" @bind-Value="Draft.Title" placeholder="Ex.: Pedidos concluídos" />
                </label>
                <label class="field-label">
                    Responsável
                    <InputText class="field-input" @bind-Value="Draft.Owner" placeholder="Ex.: Maria" />
                </label>
                <label class="field-label">
                    Área
                    <InputSelect class="field-input" @bind-Value="Draft.Area">
                        @foreach (var area in PlanningStore.Areas)
                        {
                            <option value="@area">@area</option>
                        }
                    </InputSelect>
                </label>
                <label class="field-label">
                    Unidade
                    <InputSelect class="field-input" @bind-Value="Draft.Branch">
                        @foreach (var branch in PlanningStore.Branches)
                        {
                            <option value="@branch">@branch</option>
                        }
                    </InputSelect>
                </label>
                <label class="field-label">
                    Tipo de valor
                    <InputSelect class="field-input" @bind-Value="Draft.Unit">
                        <option value="%">Percentual (%)</option>
                        <option value="R$">Moeda (R$)</option>
                        <option value="un">Quantidade (un)</option>
                    </InputSelect>
                </label>
                <label class="field-label">
                    Previsto
                    <InputNumber class="field-input" @bind-Value="Draft.Target" min="0.01" step="0.01" />
                </label>
                <label class="field-label">
                    Realizado
                    <InputNumber class="field-input" @bind-Value="Draft.Actual" min="0" step="0.01" />
                </label>
            </div>
            <div class="form-actions">
                <button class="button button-quiet" type="button" @onclick="ToggleForm">Cancelar</button>
                <button class="button button-primary" type="submit">Salvar meta</button>
            </div>
        </EditForm>
    </section>
}

<section class="content-card">
    <div class="content-card-header">
        <div>
            <h2>Metas de @PeriodLabel</h2>
            <p>Altere o realizado diretamente na tabela ou inative metas de teste.</p>
        </div>
        <span class="count-pill">@FilteredGoals.Count registros</span>
    </div>
    <div class="management-toolbar">
        <label class="checkbox-label">
            <input type="checkbox" @bind="ShowInactive" />
            Mostrar inativos
        </label>
        <button type="button" class="button button-quiet button-small" @onclick="() => ShowResetConfirmation = !ShowResetConfirmation">Restaurar dados de exemplo</button>
    </div>
    @if (ShowResetConfirmation)
    {
        <div class="reset-warning" role="alert">
            <div><strong>Substituir todos os dados?</strong><p>Essa ação apagará suas metas locais e restaurará os dados fictícios dos últimos seis meses.</p></div>
            <div class="reset-actions">
                <button class="button button-quiet button-small" type="button" @onclick="() => ShowResetConfirmation = false">Cancelar</button>
                <button class="button button-danger button-small" type="button" @onclick="RestoreDemo">Confirmar restauração</button>
            </div>
        </div>
    }
    @if (FilteredGoals.Count == 0)
    {
        <div class="empty-state"><h3>Nenhuma meta neste filtro</h3><p>Ative a visualização de inativos ou crie uma nova meta.</p></div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>INDICADOR</th>
                        <th>RESPONSÁVEL</th>
                        <th class="numeric">PREVISTO</th>
                        <th>REALIZADO (EDITÁVEL)</th>
                        <th>ATINGIMENTO</th>
                        <th>AÇÕES</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var goal in FilteredGoals)
                    {
                        <tr @key="goal.Id" class="@(goal.IsActive ? "" : "inactive-row")">
                            <td>
                                <div class="cell-title">@goal.Title</div>
                                <div class="cell-subtitle">@goal.Area · @goal.Branch</div>
                            </td>
                            <td>@goal.Owner</td>
                            <td class="numeric strong-number">@goal.Format(goal.Target)</td>
                            <td>
                                <div class="actual-editor">
                                    <input aria-label="Realizado de @goal.Title" type="number" class="field-input amount-input" min="0" step="0.01"
                                           value="@goal.Actual.ToString(CultureInfo.InvariantCulture)"
                                           disabled="@(!goal.IsActive)"
                                           @onchange="e => ChangeActual(goal.Id, e.Value?.ToString())" />
                                    <span>@goal.Unit</span>
                                </div>
                            </td>
                            <td>
                                <strong class="progress-percent">@goal.Progress.ToString("N1", BrazilianCulture)%</strong>
                                <div class="progress-line"><div class="progress-fill @goal.StatusClass" style="width: @(Math.Clamp(goal.Progress, 0m, 100m).ToString(CultureInfo.InvariantCulture))%"></div></div>
                            </td>
                            <td>
                                <button type="button" class="text-action" @onclick="() => ToggleActive(goal.Id)">
                                    @(goal.IsActive ? "Inativar" : "Reativar")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
<div class="info-note"><span aria-hidden="true">ⓘ</span> As alterações são persistidas em SQLite local. Este painel é uma demonstração sem autenticação: use somente em ambiente controlado.</div>

@code {
    private static readonly CultureInfo BrazilianCulture = CultureInfo.GetCultureInfo("pt-BR");
    private GoalDraft Draft = new();
    private bool ShowForm;
    private bool ShowInactive;
    private bool ShowResetConfirmation;
    private string PeriodLabel => DateTime.Today.ToString("MMMM 'de' yyyy", BrazilianCulture);
    private List<Goal> FilteredGoals => Store.Goals
        .Where(g => g.Month == DateTime.Today.Month && g.Year == DateTime.Today.Year)
        .Where(g => ShowInactive || g.IsActive)
        .OrderBy(g => g.IsActive ? 0 : 1)
        .ThenBy(g => g.Title)
        .ToList();

    private void ToggleForm() => ShowForm = !ShowForm;

    private void CreateGoal()
    {
        Store.Add(Draft);
        Draft = new GoalDraft();
        ShowForm = false;
    }

    private void ToggleActive(Guid id) => Store.ToggleActive(id);

    private void ChangeActual(Guid id, string? raw)
    {
        if (decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount))
            Store.SetActual(id, amount);
    }

    private void RestoreDemo()
    {
        Store.RestoreDemo();
        ShowResetConfirmation = false;
        ShowForm = false;
        Draft = new GoalDraft();
    }
}
